APP_ENV=development
MAX_WS_URL=wss://max-stream.maicoin.com/ws
MARKETS=btctwd,ethtwd
KAFKA_BROKERS=localhost:19092
KAFKA_TLS_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
MARKET_EVENTS_TOPIC=market.events.v1
RISK_SNAPSHOTS_TOPIC=risk.snapshots.v1
DATABASE_URL=postgres://maxsentinel:maxsentinel@localhost:5432/maxsentinel?sslmode=disable
REQUIRE_DATABASE=false
MARKETDATA_HTTP_ADDR=:8081
RISK_GRPC_ADDR=:9090
RISK_HTTP_ADDR=:8082
GATEWAY_HTTP_ADDR=:8080
RISK_GROUP_ID=max-sentinel-risk
# Prefix; the gateway appends its runtime instance ID so every replica receives all snapshots.
GATEWAY_GROUP_ID=max-sentinel-gateway
MAX_BOOK_DEPTH=20
RISK_WINDOW_SIZE=120
RISK_WARN_SPREAD_BPS=35
RISK_CRITICAL_SPREAD_BPS=80
RISK_WARN_VOLATILITY=0.015
RISK_CRITICAL_VOLATILITY=0.030
RISK_STALE_AFTER_SECONDS=10
PAPER_MAX_NOTIONAL_TWD=100000
